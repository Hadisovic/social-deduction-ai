# Source provenance hashes refer to repository bytes, not platform line endings.
assets/skeld/sources/* -text
skeld_config.py text eol=lf
skeld_config_legacy.py text eol=lf

# Preserve the measured Phase 3 source bytes across Windows checkouts.
phase3*.py text eol=lf
run_phase3*.py text eol=lf
social_deduction/phase3*.py text eol=lf
assets/phase3_assets.json text eol=lf

# Phase 4 reproducible source/schema/checkpoint metadata.
belief/*.py text eol=lf
phase4*.py text eol=lf
run_phase4.py text eol=lf
train_phase4.py text eol=lf
evaluate_phase4.py text eol=lf
artifacts/phase4/*.json text eol=lf

# The historical V2 checkpoint locks this JSON's raw CRLF bytes. Preserve them.
assets/skeld/among_us_map.json -text whitespace=cr-at-eol
# Handoff code is portable; original model/checksum/artwork bytes are binary.
frozen_handoff/*.py text eol=lf
spectator/**/*.py text eol=lf
artifacts/crew-handoff/**/*.pt -text
assets/phase3_local/** -text

# Provisional Jane definitions have portable source/data fingerprints.
jane/** text eol=lf
docs/jane/** text eol=lf
JANE_SHARED.md text eol=lf
tests/test_jane_foundation.py text eol=lf
