# Python virtual environments
.venv/
venv/
env/
ENV/

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Pytest / testing cache
.pytest_cache/
.coverage
htmlcov/

# Editor / IDE metadata
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db

# Model checkpoints and binaries (large neural network weights)
models/*
!models/.gitkeep

# Training logs, monitor CSVs, evaluations, and TensorBoard events
logs/*
!logs/.gitkeep

# Temporary smoke test outputs and scratch files
temp_*
*.tmp
*.log

# Root-level transient render snapshots (curated images are in docs/images/)
snapshot_*.png

# Optional user-requested commercial artwork; never included in public commits.
assets/phase3_local/
